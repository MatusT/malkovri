{
  "name": "malkovri-wgsl-debugger",
  "displayName": "Malkovri WGSL Debugger",
  "description": "Malkovri WGSL Debugger",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "publisher": "malkovri",
  "categories": [
    "Debuggers"
  ],
  "activationEvents": ["onDebug"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wgsl",
        "aliases": ["WGSL", "wgsl"],
        "extensions": [".wgsl"]
      }
    ],
    "debuggers": [
      {
        "type": "wgsl",
        "label": "WGSL Debugger",
        "languages": ["wgsl"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the WGSL shader file to debug."
              },
              "shaderInputs": {
                "type": "object",
                "description": "Entry-point builtin values passed to the shader.",
                "default": {},
                "properties": {
                  "global_invocation_id": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0, 0, 0],
                    "description": "@builtin(global_invocation_id)"
                  },
                  "local_invocation_id": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0, 0, 0],
                    "description": "@builtin(local_invocation_id)"
                  },
                  "local_invocation_index": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "@builtin(local_invocation_index)"
                  },
                  "workgroup_id": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0, 0, 0],
                    "description": "@builtin(workgroup_id)"
                  },
                  "workgroup_size": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0, 0, 0],
                    "description": "@builtin(workgroup_size)"
                  },
                  "num_workgroups": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0, 0, 0],
                    "description": "@builtin(num_workgroups)"
                  },
                  "vertex_index": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "@builtin(vertex_index)"
                  },
                  "instance_index": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "@builtin(instance_index)"
                  },
                  "front_facing": {
                    "type": "boolean",
                    "default": false,
                    "description": "@builtin(front_facing)"
                  },
                  "position": {
                    "type": "array",
                    "items": { "type": "number" },
                    "default": [0, 0, 0, 0],
                    "description": "@builtin(position)"
                  },
                  "sample_index": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "@builtin(sample_index)"
                  },
                  "sample_mask": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "@builtin(sample_mask)"
                  }
                },
                "additionalProperties": true
              },
              "bindings": {
                "type": "object",
                "description": "WebGPU resource bindings, keyed by 'group:binding' (e.g. '0:0').",
                "additionalProperties": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["f32", "i32", "u32"],
                      "description": "Scalar element type of the buffer."
                    },
                    "inline": {
                      "type": "array",
                      "description": "Inline array of values. Cannot be combined with 'file'."
                    },
                    "file": {
                      "type": "string",
                      "description": "Path to a data file (relative to the shader). Cannot be combined with 'inline'."
                    },
                    "format": {
                      "type": "string",
                      "enum": ["ron", "binary"],
                      "default": "ron",
                      "description": "File format: 'ron' (RON array, default) or 'binary' (little-endian 4-byte values)."
                    }
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "wgsl",
            "request": "launch",
            "name": "Launch Program",
            "program": "${workspaceFolder}/shader.wgsl"
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "wgsl"
      }
    ]
  },
  "dependencies": {
    "malkovri_wgsl_debugger_wasm": "file:../malkovri_wgsl_debugger_wasm/pkg",
    "@types/vscode": "^1.103.0"
  }
}
